# NEPConfig.cmake.in - CMake configuration file for NEP
# Generated from NEPConfig.cmake.in by CMake

@PACKAGE_INIT@

set(NEP_VERSION "@PROJECT_VERSION@")

# Set the installation prefix
set(NEP_INSTALL_PREFIX "@CMAKE_INSTALL_PREFIX@")

# Library installation directory
set(NEP_LIBRARY_DIR "@CMAKE_INSTALL_FULL_LIBDIR@")

# Include directory
set(NEP_INCLUDE_DIR "@CMAKE_INSTALL_FULL_INCLUDEDIR@")

# GRIB2 UDF Handler - Disabled for v1.0.0 (LZ4 compression release only)
# Will be re-enabled in v2.0.0 for GRIB2 UDF support
# GRIB2 UDF support availability
# set(NEP_HAVE_GRIB2 @HAVE_GRIB2@)

# CDF library detection (v1.3.0) - library detection only, no UDF yet
set(NEP_HAVE_CDF @HAVE_CDF@)

# Initialize target list
set(NEP_LIBRARIES "")

# GRIB2 UDF Handler - Disabled for v1.0.0 (LZ4 compression release only)
# Will be re-enabled in v2.0.0 for GRIB2 UDF support
# Define imported target for GRIB2 library if available
# if(NEP_HAVE_GRIB2)
#     if(NOT TARGET NEP::ncgrib2)
#         add_library(NEP::ncgrib2 SHARED IMPORTED)
#         set_target_properties(NEP::ncgrib2 PROPERTIES
#             IMPORTED_LOCATION "${NEP_LIBRARY_DIR}/libncgrib2.so"
#             INTERFACE_INCLUDE_DIRECTORIES "${NEP_INCLUDE_DIR}"
#         )
#         list(APPEND NEP_LIBRARIES NEP::ncgrib2)
#     endif()
# endif()

# Provide summary information
message(STATUS "Found NEP version ${NEP_VERSION} - format handler support")
# GRIB2 UDF Handler - Disabled for v1.0.0
# if(NEP_HAVE_GRIB2)
#     message(STATUS "NEP GRIB2 UDF support available")
# endif()
if(NEP_HAVE_CDF)
    message(STATUS "NEP CDF library detection enabled (library location only, no UDF yet)")
endif()

if("@NEP_HAVE_NEXTCDF4_FORTRAN@")
    include(CMakeFindDependencyMacro)
    find_dependency(PkgConfig)
    pkg_check_modules(NEP_NETCDFF IMPORTED_TARGET netcdf-fortran>=4.6.2)
    if(NOT NEP_NETCDFF_FOUND)
        # pkg-config may be unavailable or unable to resolve
        # netcdf-fortran's own Requires chain across prefixes;
        # fall back to locating the library via CMAKE_PREFIX_PATH.
        find_library(NEP_NETCDFF_LIBRARY NAMES netcdff)
        find_path(NEP_NETCDFF_INCLUDE_DIR NAMES netcdf.mod)
        if(NOT NEP_NETCDFF_LIBRARY OR NOT NEP_NETCDFF_INCLUDE_DIR)
            message(FATAL_ERROR "NEP requires netcdf-fortran>=4.6.2: could not find libnetcdff and netcdf.mod")
        endif()
        add_library(PkgConfig::NEP_NETCDFF INTERFACE IMPORTED)
        set_target_properties(PkgConfig::NEP_NETCDFF PROPERTIES
            INTERFACE_LINK_LIBRARIES "${NEP_NETCDFF_LIBRARY}"
            INTERFACE_INCLUDE_DIRECTORIES "${NEP_NETCDFF_INCLUDE_DIR}")
    endif()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/NEPTargets.cmake")

check_required_components(NEP)
