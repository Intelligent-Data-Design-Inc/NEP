# This script runs the Fortran tests in the NCSQUEEZE project.
#
# Edward Hartnett, Intelligent Data Design, Inc., 9/9/25
set -x
set -e

# Use the generated .ncrc for UDF autoload (FITS, GRIB2, CDF, GeoTIFF).
# NETCDF_RC must be a directory containing a file named .ncrc.
NETCDF_RC="$(cd .. && pwd)"
export NETCDF_RC

# If FITS is enabled, run the FITS UDF test.
if test "@BUILD_FITS@" = "yes"; then
    ./ftst_fits_udf
fi

# If DICOM is enabled, run the DICOM UDF test.
if test "@BUILD_DICOM@" = "yes"; then
    ./ftst_dicom_udf
fi

# If PDB is enabled, run the PDB UDF smoke test.
if test "@BUILD_PDB@" = "yes"; then
    ./ftst_pdb_udf
fi

# If PDBx/mmCIF is enabled, run the mmCIF UDF smoke test.
if test "@BUILD_MMCIF@" = "yes"; then
    ./ftst_mmcif_udf
fi
