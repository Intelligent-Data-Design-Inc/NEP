set(prefix "${BINARY}/ftest/installed_nextcdf4/prefix")
set(consumer_build "${BINARY}/ftest/installed_nextcdf4/build")
function(run)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE status)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Installed consumer command failed (${status}): ${ARGV}")
    endif()
endfunction()
run("${CMAKE_COMMAND}" --install "${BINARY}" --prefix "${prefix}")
foreach(artifact "${LIBDIR}/libnepnextcdf4f.so" "${INCLUDEDIR}/nep/nep_nextcdf4.mod")
    if(NOT EXISTS "${prefix}/${artifact}")
        message(FATAL_ERROR "Missing installed binding: ${artifact}")
    endif()
endforeach()
set(ENV{LD_LIBRARY_PATH} "${prefix}/${LIBDIR}:${DEPENDENCY_LIBS}")
set(ENV{NETCDF_RC} "${consumer_build}")
set(ENV{NCRCENV_RC} "${consumer_build}/empty.ncrc")
file(MAKE_DIRECTORY "${consumer_build}")
file(WRITE "${consumer_build}/empty.ncrc" "")
run("${CMAKE_COMMAND}" -S "${SOURCE}/ftest/installed_nextcdf4" -B "${consumer_build}"
    "-DCMAKE_Fortran_COMPILER=${FC}" "-DCMAKE_PREFIX_PATH=${prefix};${DEPENDENCY_PREFIXES}"
    "-DNEP_DIR=${prefix}/${LIBDIR}/cmake/NEP")
run("${CMAKE_COMMAND}" --build "${consumer_build}")
run("${CMAKE_CTEST_COMMAND}" --test-dir "${consumer_build}" --output-on-failure)
