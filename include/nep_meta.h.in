/*! \file nep_meta.h
 *
 * Meta information for NEP which can be used by other packages which
 * depend on NEP.
 *
 * This file is automatically generated by the build system
 * at configure time, and contains information related to
 * how NEP was built.  It will not be required to
 * include this file unless you want to probe the capabilities
 * of NEP. This should ideally only happen when configuring
 * a project which depends on NEP.  At configure time,
 * the dependent project can set its own macros which can be used
 * in conditionals.
 */

#ifndef NEP_META_H
#define NEP_META_H

#define NEP_VERSION_MAJOR @NEP_VERSION_MAJOR@ /*!< NEP major version. */
#define NEP_VERSION_MINOR @NEP_VERSION_MINOR@ /*!< NEP minor version. */
#define NEP_VERSION_PATCH @NEP_VERSION_PATCH@ /*!< NEP patch version. */
#define NEP_VERSION_NOTE  "@NEP_VERSION_NOTE@" /*!< NEP version note. May be blank. */

/*! NEP version string.
 *
 * The format of the NEP version string is as follows:
 * \code
 * NEP_VERSION_MAJOR.NEP_VERSION_MINOR.NEP_VERSION_PATCH.NEP_VERSION_NOTE
 * \endcode
 * Note that the trailing NEP_VERSION_NOTE may be empty. It serves for
 * identifiers such as '-rc1', etc.
 */
#define NEP_VERSION       "@NEP_VERSION@"

#define NEP_BUILD_DATE       "@NEP_BUILD_DATE@" /*!< NEP build date. */
#define NEP_COMPILER_NAME    "@NEP_COMPILER_NAME@" /*!< C compiler name. */
#define NEP_COMPILER_VERSION "@NEP_COMPILER_VERSION@" /*!< C compiler version. */

#define NEP_HAS_HDF5         @NEP_HAS_HDF5@ /*!< HDF5 support. */
#define NEP_HAS_NETCDF       @NEP_HAS_NETCDF@ /*!< NetCDF-C support. */
#define NEP_HAS_LZ4          @NEP_HAS_LZ4@ /*!< LZ4 compression filter support. */
#define NEP_HAS_BZIP2        @NEP_HAS_BZIP2@ /*!< BZIP2 compression filter support. */
#define NEP_HAS_FORTRAN      @NEP_HAS_FORTRAN@ /*!< Fortran wrapper support. */

#define NEP_HAS_CDF          @NEP_HAS_CDF@ /*!< NASA CDF UDF support. */
#define NEP_HAS_GEOTIFF      @NEP_HAS_GEOTIFF@ /*!< GeoTIFF UDF support. */
#define NEP_HAS_GRIB2        @NEP_HAS_GRIB2@ /*!< GRIB2 UDF support. */
#define NEP_HAS_FITS         @NEP_HAS_FITS@ /*!< FITS UDF support. */
#define NEP_HAS_PDS4         @NEP_HAS_PDS4@ /*!< PDS4 UDF support. */
#define NEP_HAS_DICOM        @NEP_HAS_DICOM@ /*!< DICOM UDF support. */
#define NEP_HAS_PDB          @NEP_HAS_PDB@ /*!< Legacy PDB UDF support. */
#define NEP_HAS_MMCIF        @NEP_HAS_MMCIF@ /*!< PDBx/mmCIF UDF support. */
#define NEP_HAS_NEXTCDF4     @NEP_HAS_NEXTCDF4@ /*!< NEXTCDF-4 UDF backend support. */

#define NEP_HAS_NCZARR       @NEP_HAS_NCZARR@ /*!< NcZarr support. */
#define NEP_HAS_PARALLEL     @NEP_HAS_PARALLEL@ /*!< Parallel I/O support. */
#define NEP_HAS_BENCHMARKS   @NEP_HAS_BENCHMARKS@ /*!< Benchmark programs. */
#define NEP_HAS_VIZ_EXAMPLES @NEP_HAS_VIZ_EXAMPLES@ /*!< Python visualization examples. */
#define NEP_HAS_OPENDAP      @NEP_HAS_OPENDAP@ /*!< OPeNDAP examples. */
#define NEP_HAS_LOGGING      @NEP_HAS_LOGGING@ /*!< NetCDF-C-style logging support. */

#endif
