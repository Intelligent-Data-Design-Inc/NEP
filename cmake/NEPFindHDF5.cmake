# Find HDF5 for NEP and check that NetCDF-C uses the same HDF5.
# Author: Edward Hartnett, Intelligent Data Design, Inc.

find_package(HDF5 REQUIRED COMPONENTS C HL)

# HDF5 2.x CMake config files set HDF5_PROVIDES_PARALLEL instead of the
# HDF5_ENABLE_PARALLEL that FindHDF5 copies into HDF5_IS_PARALLEL.
if(NOT HDF5_IS_PARALLEL AND HDF5_PROVIDES_PARALLEL)
    set(HDF5_IS_PARALLEL TRUE)
endif()

if(NOT HDF5_VERSION OR HDF5_VERSION VERSION_LESS "1.14.0")
    message(FATAL_ERROR "NEP requires HDF5 1.14.0 or newer (found ${HDF5_VERSION})")
endif()

foreach(_nep_hdf5_target hdf5::hdf5 hdf5::hdf5_hl HDF5::HDF5)
    if(NOT TARGET ${_nep_hdf5_target})
        message(FATAL_ERROR "FindHDF5 did not create the hdf5::hdf5, hdf5::hdf5_hl and HDF5::HDF5 targets; NEP requires CMake 3.19 or newer")
    endif()
endforeach()

set(NEP_HDF5_LIBRARY "")
foreach(_nep_hdf5_prop IMPORTED_LOCATION IMPORTED_LOCATION_RELEASE IMPORTED_LOCATION_DEBUG)
    if(NOT NEP_HDF5_LIBRARY)
        get_target_property(_nep_hdf5_loc hdf5::hdf5 ${_nep_hdf5_prop})
        if(_nep_hdf5_loc)
            set(NEP_HDF5_LIBRARY "${_nep_hdf5_loc}")
        endif()
    endif()
endforeach()
if(NOT NEP_HDF5_LIBRARY)
    message(FATAL_ERROR "FindHDF5 did not set an imported location on the hdf5::hdf5 target")
endif()

get_filename_component(NEP_HDF5_LIBRARY_DIR "${NEP_HDF5_LIBRARY}" DIRECTORY)

# HL comes first for static link order. HDF5::HDF5 carries libhdf5 and
# its own dependencies in both config and module mode.
set(NEP_HDF5_LIBRARIES hdf5::hdf5_hl HDF5::HDF5)

if(HDF5_DIR AND NOT HDF5_DIR MATCHES "-NOTFOUND")
    message(STATUS "NEP HDF5 ${HDF5_VERSION}: ${NEP_HDF5_LIBRARY} (CMake config ${HDF5_DIR})")
else()
    message(STATUS "NEP HDF5 ${HDF5_VERSION}: ${NEP_HDF5_LIBRARY} (FindHDF5 module mode)")
endif()

function(nep_check_netcdf_hdf5)
    find_library(NEP_NETCDF_SHARED_LIBRARY NAMES netcdf HINTS ${NETCDF_LIBRARY_DIRS} "${NETCDF_PREFIX}/lib")
    if(CMAKE_READELF)
        set(_nep_readelf "${CMAKE_READELF}")
    else()
        find_program(NEP_READELF readelf)
        set(_nep_readelf "${NEP_READELF}")
    endif()
    if(NOT _nep_readelf OR _nep_readelf MATCHES "-NOTFOUND")
        message(STATUS "NEP: skipping NetCDF-C/HDF5 SONAME check (no readelf)")
        return()
    endif()
    if(NOT NEP_NETCDF_SHARED_LIBRARY)
        message(STATUS "NEP: skipping NetCDF-C/HDF5 SONAME check (libnetcdf not found)")
        return()
    endif()
    execute_process(COMMAND "${_nep_readelf}" -d "${NEP_NETCDF_SHARED_LIBRARY}"
        OUTPUT_VARIABLE _nep_netcdf_dynamic OUTPUT_STRIP_TRAILING_WHITESPACE)
    string(REGEX MATCHALL "\\(NEEDED\\)[^\n]*" _nep_needed_lines "${_nep_netcdf_dynamic}")
    set(_needed "")
    foreach(_nep_line ${_nep_needed_lines})
        if(_nep_line MATCHES "\\[(libhdf5(_debug)?\\.so\\.[0-9]+)\\]")
            set(_needed "${CMAKE_MATCH_1}")
        endif()
    endforeach()
    if(NOT _needed)
        message(STATUS "NEP: skipping NetCDF-C/HDF5 SONAME check (libnetcdf does not link a shared libhdf5)")
        return()
    endif()
    get_filename_component(_nep_hdf5_real "${NEP_HDF5_LIBRARY}" REALPATH)
    execute_process(COMMAND "${_nep_readelf}" -d "${_nep_hdf5_real}"
        OUTPUT_VARIABLE _nep_hdf5_dynamic OUTPUT_STRIP_TRAILING_WHITESPACE)
    string(REGEX MATCHALL "\\(SONAME\\)[^\n]*" _nep_soname_lines "${_nep_hdf5_dynamic}")
    set(_soname "")
    foreach(_nep_line ${_nep_soname_lines})
        if(_nep_line MATCHES "\\[(libhdf5(_debug)?\\.so\\.[0-9]+)\\]")
            set(_soname "${CMAKE_MATCH_1}")
        endif()
    endforeach()
    if(NOT _soname)
        message(STATUS "NEP: skipping NetCDF-C/HDF5 SONAME check (HDF5 library has no SONAME)")
        return()
    endif()
    if(NOT _needed STREQUAL _soname)
        message(FATAL_ERROR "NetCDF-C (${NEP_NETCDF_SHARED_LIBRARY}) links ${_needed}, but NEP found HDF5 ${HDF5_VERSION} (${_soname}) at ${NEP_HDF5_LIBRARY}. Set HDF5_ROOT to the HDF5 installation NetCDF-C was built with.")
    endif()
    message(STATUS "NEP: NetCDF-C and NEP both use ${_soname}")
endfunction()
